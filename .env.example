# Copy this file to .env (which git ignores) and fill it in. Never commit a real key.

# Which provider to use: openrouter or anthropic.
# If unset: openrouter when OPENROUTER_API_KEY is set, otherwise anthropic.
# LLM_PROVIDER=openrouter

# OpenRouter: cheap models for testing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Hold the demo's "as of" date still (YYYY-MM-DD). Leave unset to use today's real date.
# CONCIERGE_TODAY=2026-11-06

# The demo catalog includes invented offers under familiar brand names (Apple, lululemon, ...).
# They are on by default; set this to off to keep only the original invented stores.
# CONCIERGE_BRAND_OFFERS=off

# Anthropic: set ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN) and a model id.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
